{
  "name": "lotus-teaching-invoices",
  "version": "1.0.0",
  "description": "CLI tool to generate yoga teaching invoices from Google Calendar",
  "type": "module",
  "main": "dist/cli/main.js",
  "bin": {
    "lotus-invoices": "dist/cli/main.js"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build": "tauri build",
    "build:vite": "vite build",
    "build:vite:production": "env -u VITE_LOTUS_E2E vite build",
    "cli": "tsx src/cli/main.ts",
    "cli:build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:calendar-editing": "vitest run tests/calendar/edit-format.test.ts tests/components/CalendarEventEditing.test.tsx tests/components/InvoicesTab.test.tsx tests/hooks/useCalendarEditing.test.tsx tests/invoice/finalization.test.ts tests/invoice/rows.test.ts && tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.json --noEmit && cargo test --manifest-path src-tauri/Cargo.toml calendar_edit::tests && cargo test --manifest-path src-tauri/Cargo.toml invoice_freshness::tests && cargo test --manifest-path src-tauri/Cargo.toml invoice_files::tests::guarded_writer",
    "e2e:fake-server": "bun run tests/e2e/fake-google-calendar.ts --self-test",
    "e2e:lifecycle-selftest": "bun run tests/e2e/lifecycle-selftest.ts --self-test",
    "e2e:assert-production": "bun run tests/e2e/lifecycle-runner.ts --assert-production",
    "e2e": "bun run tests/e2e/lifecycle-runner.ts --run-isolated-e2e",
    "prepare": "prek install"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "commander": "^12.1.0",
    "react": "^19.2.4",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "yaml": "^2.6.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@wdio/cli": "^9.24.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/mocha-framework": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "jsdom": "26.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0",
    "webdriverio": "^9.24.0"
  }
}
